<% layout("/layouts/boilerplate") %>
    <div class="row mt-3">
        <div class="col-8 offset-3">
            <h3><%= listing.title %></h3>
        </div>
        <div class="card col-6 offset-3 listing-card">
            <img src="<%= listing.image %>" class="card-img-top show-img" alt="listing_image">
            <div class="card-body">
                <p class="card-text">
                    Owned by <i><%= listing.owner.username %></i> <br><br>
                    <%= listing.description %> <br>
                        &#8377; <%= listing.price.toLocaleString("en-IN") %> / night <br>
                            <%= listing.location %> <br>
                                <%= listing.country %>
                </p>
            </div>
        </div>

        <% if (currUser && currUser._id.equals(listing.owner._id)) { %>        <!-- try with this condition (currUser._id.equals(listing.owner._id)) you will get an error if no one is logged in because there is no currUser in the locals so nothing to compare with listing.owner._id -->
            <div class="btns">
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>
                <form action="/listings/<%= listing._id %>?_method=delete" method="post">
                    <button class="btn btn-dark col offset-5">Delete</button>
                </form>
            </div>
        <% } %>

        
        <div class="col-8 offset-3 mb-3">
            <hr>
            <% if(currUser) { %>
                <h4>Leave a review</h4>
            <form action="/listings/<%= listing._id %>/reviews" method="post" novalidate class="needs-validation">
                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label">review</label>
                    <input type="range" class="form-range" id="rating" name="review[rating]" min="1" max="5">
                </div>
                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comment</label>
                    <textarea class="form-control" name="review[comment]" id="comment" cols="30" rows="5" required></textarea>
                    <div class="invalid-feedback">Please enter your response</div>
                </div>
                <button class="btn btn-outline-dark">Post</button>
            </form>

            <hr>
            <% } %>

            <h4>Reviews</h4>
            <div class="row">
                <% for(review of listing.reviews)  { %>
                    <div class="card col-5 ms-3 mb-3">
                        <div class="card-body">
                            <h5 class="card-title">@<%= review.author.username %></h5>
                            <p class="card-text"><%= review.comment %></p>
                            <p class="card-text"><%= review.rating %> star</p>

                            <% if (currUser && currUser._id.equals(review.author)) { %>
                                <form class="mb-3" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
                                    <button class="btn btn-dark btn-sm">Delete</button>
                                </form>
                            <% } %>
                            
                        </div>
                    </div>
                <% } %>
            </div>
        </div>

    </div>